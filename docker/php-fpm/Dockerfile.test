FROM yiisoftware/yii2-php:8.4-fpm-nginx

WORKDIR /app

# Базовые расширения (как в основном образе)
RUN docker-php-ext-install sockets
RUN docker-php-ext-enable opcache

# PostgreSQL (для тестовой БД)
RUN apt-get update \
 && apt-get install -y --no-install-recommends libpq-dev \
 && docker-php-ext-install pdo_pgsql pgsql \
 && apt-get purge -y --auto-remove libpq-dev \
 && rm -rf /var/lib/apt/lists/*

# Xdebug — установлен, но выключен по умолчанию
RUN docker-php-ext-enable xdebug || true \
 && echo "xdebug.mode=off" >> /usr/local/etc/php/conf.d/docker-php-ext-xdebug.ini \
 && echo "xdebug.start_with_request=trigger" >> /usr/local/etc/php/conf.d/docker-php-ext-xdebug.ini \
 && echo "xdebug.client_host=host.docker.internal" >> /usr/local/etc/php/conf.d/docker-php-ext-xdebug.ini \
 && echo "xdebug.client_port=9005" >> /usr/local/etc/php/conf.d/docker-php-ext-xdebug.ini

# OPcache в тестах выключен
RUN echo "opcache.enable=0" >> /usr/local/etc/php/conf.d/docker-php-ext-opcache.ini \
 && echo "opcache.enable_cli=0" >> /usr/local/etc/php/conf.d/docker-php-ext-opcache.ini

COPY docker/nginx/default.conf /etc/nginx/conf.d/default.conf